# База данных
POSTGRES_DB=solo_analytics
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here

# Безопасность
SECRET_KEY=your-very-secret-key-minimum-32-chars-change-this

# CORS (список разрешённых origin через запятую)
CORS_ORIGINS=http://localhost:3000

# Первый администратор (создаётся при первом запуске)
FIRST_ADMIN_EMAIL=admin@solo.ru
FIRST_ADMIN_PASSWORD=change-this-password

# Демо-данные (true = загрузить демо CSV при старте)
SEED_DEMO_DATA=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

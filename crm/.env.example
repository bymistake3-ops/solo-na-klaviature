# Prisma — строка подключения к PostgreSQL.
# Для продакшена возьми её на https://neon.tech (вкладка Connection Details).
# Пример: postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Auth.js — секретный ключ для подписания cookie-сессий.
# Сгенерируй любой случайный ~40+ символов (например, на https://generate-secret.vercel.app/32).
AUTH_SECRET="поменяй-на-свой-случайный-секрет-минимум-32-символа"
AUTH_TRUST_HOST="true"

# Необязательно: URL продакшен-сайта (Vercel подставляет автоматически).
# NEXTAUTH_URL="https://educrm.vercel.app"
